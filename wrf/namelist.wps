 &share
 wrf_core = 'ARW',
 max_dom   = 3,
 start_date = '2025-12-01_00:00:00','2025-12-01_00:00:00','2025-12-01_00:00:00',
 end_date   = '2026-02-28_23:00:00','2026-02-28_23:00:00','2026-02-28_23:00:00',
 interval_seconds = 21600,
 io_form_geogrid  = 2,
/

 &geogrid
 parent_id         = 1, 1, 2,
 parent_grid_ratio = 1, 3, 3,
 i_parent_start    = 1, 19, 25,
 j_parent_start    = 1, 22, 30,
 e_we              = 70, 76, 82,
 e_sn              = 70, 76, 82,
 geog_data_res     = 'default', 'default', 'default',
 dx                = 27000,
 dy                = 27000,
 map_proj          = 'mercator',
 ref_lat           = -8.065,
 ref_lon           = 111.905,
 truelat1          = -8.065,
 stand_lon         = 111.905,
 geog_data_path    = '/home/user/WPS_GEOG',    ! <<< UBAH SESUAI PATH WSL
 /

 &ungrib
 out_format = 'WPS',
 prefix     = 'FILE',
 /

 &metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
 /
