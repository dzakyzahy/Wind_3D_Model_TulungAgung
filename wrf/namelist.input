 &time_control
 run_days                = 92,     ! Des 2025 (31) + Jan 2026 (31) + Feb 2026 (28) = 90 hari
 run_hours               = 0,
 run_minutes             = 0,
 run_seconds             = 0,
 start_year              = 2025, 2025, 2025,
 start_month             = 12,   12,   12,
 start_day               = 01,   01,   01,
 start_hour              = 00,   00,   00,
 end_year                = 2026, 2026, 2026,
 end_month               = 02,   02,   02,
 end_day                 = 28,   28,   28,
 end_hour                = 23,   23,   23,
 interval_seconds        = 21600,
 input_from_file         = .true., .true., .true.,
 history_interval        = 60, 60, 60,           ! output per jam
 frames_per_outfile      = 24, 24, 24,            ! 1 file per hari
 restart                 = .false.,
 restart_interval        = 1440,
 io_form_history         = 2,
 io_form_restart         = 2,
 io_form_input           = 2,
 io_form_boundary        = 2,
 debug_level             = 0,
 /

 &domains
 time_step               = 162,    ! 6 * dx_km untuk D01 (27km → 162s)
 time_step_fract_num     = 0,
 time_step_fract_den     = 1,
 max_dom                 = 3,
 e_we                    = 70, 76, 82,
 e_sn                    = 70, 76, 82,
 e_vert                  = 50, 50, 50,   ! 50 level vertikal
 p_top_requested         = 5000,          ! top 50 hPa
 num_metgrid_levels      = 38,
 num_metgrid_soil_levels = 4,
 dx                      = 27000, 9000, 3000,
 dy                      = 27000, 9000, 3000,
 grid_id                 = 1, 2, 3,
 parent_id               = 0, 1, 2,
 i_parent_start          = 1, 19, 25,
 j_parent_start          = 1, 22, 30,
 parent_grid_ratio       = 1, 3, 3,
 parent_time_step_ratio  = 1, 3, 3,
 feedback                = 1,
 smooth_option           = 0,
 /

 &physics
 ! ── Microphysics ───────────────────────────────────────────────────────
 mp_physics              = 6, 6, 6,       ! WSM6

 ! ── Radiation ──────────────────────────────────────────────────────────
 ra_lw_physics           = 4, 4, 4,       ! RRTMG longwave
 ra_sw_physics           = 4, 4, 4,       ! RRTMG shortwave
 radt                    = 30, 30, 30,    ! interval radiasi (menit)
 swrad_scat              = 1.0,
 use_coszen_adjust       = 1,

 ! ── Surface Layer ──────────────────────────────────────────────────────
 sf_sfclay_physics       = 1, 1, 1,       ! MM5 Monin-Obukhov
 sf_surface_physics      = 2, 2, 2,       ! Noah LSM
 sf_urban_physics        = 0, 0, 0,

 ! ── PBL ─────────────────────────────────────────────────────────────────
 bl_pbl_physics          = 1, 1, 1,       ! YSU — kritis untuk wind profile
 bldt                    = 0, 0, 0,       ! update tiap timestep
 topo_wind               = 1,             ! koreksi topografi untuk angin

 ! ── Cumulus ─────────────────────────────────────────────────────────────
 cu_physics              = 1, 1, 0,       ! Kain-Fritsch untuk D01/D02, off untuk D03
 cudt                    = 5, 5, 0,

 ! ── Land Surface ─────────────────────────────────────────────────────────
 num_soil_layers         = 4,
 num_land_cat            = 21,
 sf_lake_physics         = 0,
 /

 &fdda
 /

 &dynamics
 w_damping               = 1,
 diff_opt                = 1, 1, 1,
 km_opt                  = 4, 4, 4,
 diff_6th_opt            = 2, 2, 2,
 diff_6th_factor         = 0.12, 0.12, 0.12,
 base_temp               = 290,
 damp_opt                = 3,
 zdamp                   = 5000,
 dampcoef                = 0.01,
 khdif                   = 0, 0, 0,
 kvdif                   = 0, 0, 0,
 non_hydrostatic         = .true., .true., .true.,
 moist_adv_opt           = 1, 1, 1,
 scalar_adv_opt          = 1, 1, 1,
 /

 &bdy_control
 spec_bdy_width          = 5,
 spec_zone               = 1,
 relax_zone              = 4,
 specified               = .true., .false., .false.,
 nested                  = .false., .true., .true.,
 /

 &grib2
 /

 &namelist_quilt
 nio_tasks_per_group     = 0,
 nio_groups              = 1,
 /
